NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Vide = Postgres embarqué (PGlite) stocké dans ./.data (dev uniquement)
DATABASE_URL=
# DATABASE_URL=postgres://gameoflife:gameoflife@localhost:5432/gameoflife

# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-change-me-change-me-change-me-change-me

# Origines autorisées (front PHONE et ADMIN), séparées par des virgules
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Mettre true derrière un reverse proxy (nginx, Caddy, Cloudflare...)
TRUST_PROXY=false
